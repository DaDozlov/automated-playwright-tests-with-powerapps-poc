# Web link of the app: make.powerapps.com -> Apps -> ... -> Details -> Web link.
# Keep tenantId, drop hint and sourcetime, add &hidenavbar=true.
APP_URL=https://apps.powerapps.com/play/e/<environment-id>/a/<app-id>?tenantId=<tenant-id>&hidenavbar=true

# SharePoint list the app writes to
SP_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
SP_LIST_TITLE=New Clients

# Optional: automatic sign-in, only for accounts without MFA.
# Leave empty to sign in yourself in the browser window that `npm run login` opens.
TEST_USER=
TEST_PASSWORD=
