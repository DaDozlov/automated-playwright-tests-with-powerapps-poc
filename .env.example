# Copy to .env and fill in. .env is git-ignored.

# Power Apps play URL (make.powerapps.com → Apps → ⋯ → Details → Web link).
# Keep tenantId; drop hint/sourcetime. hidenavbar=true hides the Power Apps header.
APP_URL=https://apps.powerapps.com/play/e/<environment-id>/a/<app-id>?tenantId=<tenant-id>&hidenavbar=true

# SharePoint site and list the app writes to
SP_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
SP_LIST_TITLE=New Clients

# Optional: a test account WITHOUT MFA, for unattended login (CI).
# Leave empty to sign in by hand in a browser window (works with MFA).
TEST_USER=
TEST_PASSWORD=
